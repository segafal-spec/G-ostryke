rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Lecture publique de tous les assets du jeu (cartes, médias, logos, avatars)
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. Dossiers personnels utilisateurs : strictement partitionné par UID !
    // Un joueur ne peut uploader ou modifier que ses propres fichiers dans /users/{userId}/...
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'segafal@gmail.com'
      );
    }

    // 3. Dossiers administrateurs réservés au fondateur / admins
    match /admin/{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.email == 'segafal@gmail.com';
    }
  }
}
