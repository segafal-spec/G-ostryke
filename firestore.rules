rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper : vérifie si l'utilisateur courant est admin
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true) ||
        (request.auth.token.keys().hasAny(['admin', 'superadmin']) &&
         (request.auth.token.admin == true || request.auth.token.superadmin == true)) ||
        request.auth.token.email == 'segafal@gmail.com'
      );
    }

    // Helper : vérifie que l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Admins : collection réservée exclusivement aux admins ─────────────────
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ── Rounds quotidiens : lecture publique, écriture admin uniquement ───────
    match /daily_rounds/{roundDate} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Questions :
    // - Les administrateurs peuvent tout lire et modifier
    // - Les joueurs peuvent lire les questions actives et validées, OU leurs propres questions soumises
    // - Les joueurs authentifiés peuvent soumettre une question avec statut_validation: "en_attente"
    match /questions/{questionId} {
      allow read: if isAdmin() || (
        resource.data.statut_validation == 'validee' &&
        resource.data.actif == true
      ) || (
        isAuthenticated() && resource.data.soumis_par == request.auth.uid
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.soumis_par == request.auth.uid &&
        request.resource.data.statut_validation == 'en_attente' &&
        request.resource.data.actif == false
      );
      allow update, delete: if isAdmin();
    }

    // ── Scores : lecture publique, création sécurisée liée à l'UID de l'utilisateur authentifié
    // RÈGLE STRICTE : Un joueur ne peut enregistrer un score QUE pour son propre UID !
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    // ── Utilisateurs : lecture pour profils & leaderboards, modification strictement isolée par UID
    // Protection anti-usurpation : chaque utilisateur n'a le droit de modifier que son document personnel /users/{userId}
    match /users/{userId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.auth.uid == userId && 
                        !('is_admin' in request.resource.data && request.resource.data.is_admin == true)) 
                    || isAdmin();
      allow update: if (isAuthenticated() && request.auth.uid == userId && 
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin', 'isAdmin', 'role']) || isAdmin()))
                    // Autorise la transaction de crédit du bonus de 500 points par un filleul authentifié validant sa 1ère manche
                    || (isAuthenticated() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bonus_points', 'score_total_cumule', 'total_points', 'referrals_count', 'maj_le']) &&
                        request.resource.data.bonus_points == resource.data.bonus_points + 500)
                    || isAdmin();
      allow delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();

      // Sous-collections éventuelles liées au compte utilisateur : strictement réservées au titulaire
      match /{allSubcollections=**} {
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ── Comptes supprimés : conservation légale des emails et données d'archives (consultable/téléchargeable par Admin) ──
    match /deleted_accounts/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() || isAdmin();
    }

    // ── Groupes et ligues (héritage / compatibilité) ──────────────────────────
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Challenges privés ────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Stats globales ───────────────────────────────────────────────────────
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Collection Mail (pour envois et notifications e-mails) ───────────────
    match /mail/{mailId} {
      allow create: if isAuthenticated() || isAdmin();
      allow read: if isAdmin();
    }
  }
}
