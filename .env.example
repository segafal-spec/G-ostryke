# Configuration Client Firebase pour BizGames
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=bizgames-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bizgames-app
VITE_FIREBASE_STORAGE_BUCKET=bizgames-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Configuration optionnelle pour l'envoi d'e-mails transactionnels (Brevo ou Resend)
VITE_BREVO_API_KEY=
VITE_RESEND_API_KEY=
